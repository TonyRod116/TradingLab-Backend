{
  "entry_rules":[
    {
      "name":"VWAP+RSI Long",
      "rule_type":"condition",
      "action_type":"buy",
      "conditions":[
        {"left_operand":"low","operator":"lt","right_operand":"vwap_minus_1_5","logical_operator":"and"},
        {"left_operand":"rsi","operator":"lt","right_operand":"30","logical_operator":"and"}
      ]
    }
  ],
  "exit_rules": [
    {
      "name":"Exit RSI>50 or close>VWAP",
      "rule_type":"condition",
      "action_type":"sell",
      "conditions":[
        {"left_operand":"rsi","operator":"gt","right_operand":"50","logical_operator":"or"},
        {"left_operand":"close","operator":"gt","right_operand":"vwap"}
      ]
    }
  ],
  "stop_loss_type":"percentage","stop_loss_value":1,
  "take_profit_type":"percentage","take_profit_value":2
